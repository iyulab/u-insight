<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>UInsight.Tests</RootNamespace>

    <!-- What a trimmed or NativeAOT host runs with: any reflection-based JSON in the
         client throws here exactly as it would there. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>

    <!-- The native library from a `cargo build`. A standalone clone builds into its own
         target/; inside a Cargo workspace it lands in the workspace's. -->
    <!-- A build told where to put its output (CARGO_TARGET_DIR, as the umbrella's
         release gate sets it) is the one to test: a library left in the repository's
         own target/ by an earlier build would otherwise be picked first. -->
    <UInsightNativeDir Condition="'$(UInsightNativeDir)' == '' and '$(CARGO_TARGET_DIR)' != '' and (Exists('$(CARGO_TARGET_DIR)/debug/u_insight.dll') or Exists('$(CARGO_TARGET_DIR)/debug/libu_insight.so') or Exists('$(CARGO_TARGET_DIR)/debug/libu_insight.dylib'))">$(CARGO_TARGET_DIR)/debug</UInsightNativeDir>
    <UInsightNativeDir Condition="'$(UInsightNativeDir)' == '' and (Exists('$(MSBuildThisFileDirectory)../../../target/debug/u_insight.dll') or Exists('$(MSBuildThisFileDirectory)../../../target/debug/libu_insight.so') or Exists('$(MSBuildThisFileDirectory)../../../target/debug/libu_insight.dylib'))">$(MSBuildThisFileDirectory)../../../target/debug</UInsightNativeDir>
    <UInsightNativeDir Condition="'$(UInsightNativeDir)' == ''">$(MSBuildThisFileDirectory)../../../../../target/debug</UInsightNativeDir>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="4.0.1" />
  </ItemGroup>

  <ItemGroup>
    <None Include="$(UInsightNativeDir)/u_insight.dll" Condition="Exists('$(UInsightNativeDir)/u_insight.dll')"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(UInsightNativeDir)/libu_insight.so" Condition="Exists('$(UInsightNativeDir)/libu_insight.so')"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
    <None Include="$(UInsightNativeDir)/libu_insight.dylib" Condition="Exists('$(UInsightNativeDir)/libu_insight.dylib')"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <!-- The C header cbindgen generates from the engine (CI keeps it current): the
         struct layouts the client declares are checked against it. -->
    <None Include="../../../include/u_insight.h" Link="u_insight.h"
          CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../UInsight/UInsight.csproj" />
  </ItemGroup>

</Project>

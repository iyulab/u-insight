<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>UInsight</RootNamespace>
    <AssemblyName>UInsight</AssemblyName>

    <!-- NuGet Package Metadata -->
    <PackageId>UInsight</PackageId>
    <Version>0.29.0</Version>
    <Authors>iyulab</Authors>
    <Company>iyulab</Company>
    <Product>UInsight</Product>
    <Description>Statistical analysis and data profiling engine. High-performance Rust library with C# bindings for clustering, PCA, anomaly detection, and more.</Description>
    <PackageTags>statistics;profiling;clustering;pca;anomaly-detection;ffi;machine-learning</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/iyulab/u-insight</PackageProjectUrl>
    <RepositoryUrl>https://github.com/iyulab/u-insight</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Build Configuration -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>

    <!-- Trimmed and NativeAOT hosts: the analyzers fail the build on anything that
         would need reflection at run time. -->
    <IsAotCompatible>true</IsAotCompatible>
    <WarningsAsErrors>$(WarningsAsErrors);IL2026;IL2046;IL2057;IL2060;IL2067;IL2070;IL2072;IL2075;IL2087;IL2091;IL3050;IL3051</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="\" />

    <!-- MSBuild .targets for auto-copy of native library -->
    <None Include="build\UInsight.targets" Pack="true" PackagePath="build\" />
    <None Include="build\UInsight.targets" Pack="true" PackagePath="buildTransitive/UInsight.targets" />

    <!-- Native libraries, one per runtime identifier, placed under runtimes/ by the
         NuGet release workflow; its build matrix is the list of runtimes. -->
    <None Include="runtimes/**/*" Pack="true" PackagePath="runtimes/" />
  </ItemGroup>

</Project>

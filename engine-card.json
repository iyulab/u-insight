{
  "$schema": "scripts/engine-card/engine-card.schema.json",
  "card_version": 1,
  "engine": {
    "id": "u-insight",
    "summary": "Statistical analysis of tabular data: column profiles, correlation, clustering (k-means, DBSCAN, hierarchical), PCA, anomaly detection (isolation forest, LOF, univariate outlier rules), distribution analysis with normality tests and fits, OLS regression, feature importance, multicollinearity diagnostics and univariate time-series period and anomaly scoring.",
    "version": "0.36.1",
    "license": "MIT",
    "repository": "https://github.com/iyulab/u-insight"
  },
  "surfaces": [
    {
      "kind": "crate",
      "name": "u-insight",
      "package_version": "0.36.1",
      "engine_version": "0.36.1",
      "error_shape": "Err(InsightError), whose variant names the reason and holds the values behind it."
    },
    {
      "kind": "npm",
      "name": "@iyulab/u-insight",
      "package_version": "0.36.1",
      "engine_version": "0.36.1",
      "wasm": true,
      "note": "Native JS values in and out, typed in the .d.ts; column-major inputs are objects keyed by column name. Bundler and Node targets; no bundler-less browser build.",
      "error_shape": "A thrown Error whose code property is the code, with the fields (parameter, index, min, max, got, expected, ...) as its other properties."
    },
    {
      "kind": "nuget",
      "name": "UInsight",
      "package_version": "0.36.1",
      "engine_version": "0.36.1",
      "note": "C ABI wrapper over C structs (the cbindgen header), versioned with the crate.",
      "error_shape": "An InsightException whose ErrorCode is the code, Parameter and Index the fields of those names, and Details the rest."
    }
  ],
  "errors": {
    "shape": "A refusal carries a stable snake_case 'code' and the fields listed for that code; how it arrives depends on the surface (error_shape).",
    "source": {
      "catalog": "code_catalog in src/wasm.rs, built from the Code table the refusals are made from; published as codes() in WebAssembly, over the C ABI and as Codes on .NET. What each code means is tabled in README.md, which a test holds equal to the catalog.",
      "test": "src/wasm.rs::code_catalog_tests::the_readme_documents_every_code_and_no_other"
    }
  },
  "operations": [
    {
      "id": "describe",
      "summary": "A profile of each column of a column-major dataset whose columns may mix numbers, strings, booleans and nulls: its data type (numeric, boolean, categorical or text) and the statistics of that type -- for a numeric column count, missing values, extremes, mean, median, spread and shape; a statistic the data does not define is absent.",
      "input": {
        "schema": "schemas/wasm.schema.json#/$defs/describe.input",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "output": {
        "schema": "schemas/wasm.schema.json#/$defs/describe.output",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "contract_test": "src/wasm.rs::engine_card_tests::every_export_is_a_card_operation_with_its_arguments",
      "hints": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      },
      "effects": {
        "filesystem": "none",
        "network": "none",
        "clock": "none",
        "randomness": "none"
      },
      "determinism": {
        "kind": "deterministic",
        "test": "src/wasm.rs::engine_card_tests::the_crate_reads_no_clock_and_no_unseeded_randomness"
      },
      "validation": {
        "status": "none"
      },
      "performance": {
        "status": "none"
      }
    },
    {
      "id": "correlation_matrix",
      "summary": "The Pearson, Spearman or Kendall correlation matrix of numeric columns, and, with their p-values, the pairs whose correlation is above 0.7 in absolute value; every column needs at least 3 values.",
      "input": {
        "schema": "schemas/wasm.schema.json#/$defs/correlation_matrix.input",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "output": {
        "schema": "schemas/wasm.schema.json#/$defs/correlation_matrix.output",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "contract_test": "src/wasm.rs::engine_card_tests::every_export_is_a_card_operation_with_its_arguments",
      "hints": {
        "read_only": true,
        "destructive": false,
        "idempotent": true,
        "open_world": false
      },
      "effects": {
        "filesystem": "none",
        "network": "none",
        "clock": "none",
        "randomness": "none"
      },
      "determinism": {
        "kind": "deterministic",
        "test": "src/wasm.rs::engine_card_tests::the_crate_reads_no_clock_and_no_unseeded_randomness"
      },
      "validation": {
        "status": "partial",
        "checks": [
          {
            "claim": "The Pearson, Spearman and Kendall (tau-b) coefficients equal SciPy's, and the pair p-values equal SciPy's (Kendall's: the asymptotic normal approximation, SciPy method='asymptotic').",
            "reference_kind": "reference_implementation",
            "reference": "SciPy 1.17.1 pearsonr, spearmanr, kendalltau",
            "method": "compares all six pairs of four columns for each method on a seeded NumPy draw, 30 rows by 4 correlated columns (and a target), rounded to six places",
            "tolerance": "1e-10 (relative) on r; 1e-6 (relative) on p",
            "test": "tests/reference_stats.rs::correlation_matrices_and_p_values_match_scipy"
          }
        ],
        "limits": [
          "Kendall's p-value is the normal approximation; SciPy's default is the exact distribution for n <= 33 without ties, which differs (6.6e-4 against 4.9e-4 at n = 30, tau 0.43). Data with ties are not covered."
        ]
      },
      "performance": {
        "status": "none"
      }
    },
    {
      "id": "kmeans",
      "summary": "k-means clustering of row-major points with k-means++ initialisation and restarts from a fixed seed: labels numbered by first appearance, centroids, within-cluster sum of squares, iterations and cluster sizes.",
      "input": {
        "schema": "schemas/wasm.schema.json#/$defs/kmeans.input",

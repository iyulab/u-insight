        "kind": "deterministic",
        "test": "src/wasm.rs::engine_card_tests::the_crate_reads_no_clock_and_no_unseeded_randomness"
      },
      "validation": {
        "status": "partial",
        "checks": [
          {
            "claim": "On well-separated blobs the partition and the within-cluster sum of squares equal scikit-learn's best of ten restarts.",
            "reference_kind": "reference_implementation",
            "reference": "scikit-learn 1.9.1 KMeans(3, n_init=10)",
            "method": "clusters a seeded NumPy draw of three Gaussian blobs of 20 points in 3 dimensions plus two far points, rounded to six places",
            "tolerance": "1e-9 (relative) inertia; partition exact",
            "test": "tests/reference_ml.rs::kmeans_finds_the_same_optimum_as_scikit_learn"
          }
        ],
        "limits": [
          "Only where the optimum is unique and easy to find; k-means is a local search, so overlapping clusters can end in different local optima."
        ]
      },
      "performance": {
        "status": "none"
      }

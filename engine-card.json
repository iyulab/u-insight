      "input": {
        "schema": "schemas/wasm.schema.json#/$defs/describe.input",
        "freshness_test": "src/wasm.rs::engine_card_tests::the_schemas_are_generated_from_the_binding_types"
      },
      "output": {
        "schema": "schemas/wasm.schema.json#/$defs/describe.output",

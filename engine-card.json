{
  "$schema": "scripts/engine-card/engine-card.schema.json",
  "card_version": 1,
  "engine": {
    "id": "u-insight",
    "summary": "Statistical analysis of tabular data: column profiles, correlation, clustering (k-means, DBSCAN, hierarchical), PCA, anomaly detection (isolation forest, LOF, univariate outlier rules), distribution analysis with normality tests and fits, OLS regression, feature importance, multicollinearity diagnostics and univariate time-series period and anomaly scoring.",
    "version": "0.36.0",
    "license": "MIT",
    "repository": "https://github.com/iyulab/u-insight"
  },
  "surfaces": [
    {
      "kind": "crate",
      "name": "u-insight",
      "package_version": "0.36.0",
      "engine_version": "0.36.0",
      "error_shape": "Err(InsightError), whose variant names the reason and holds the values behind it."
    },
    {
      "kind": "npm",
      "name": "@iyulab/u-insight",
      "package_version": "0.36.0",
      "engine_version": "0.36.0",
      "wasm": true,
      "note": "Native JS values in and out, typed in the .d.ts; column-major inputs are objects keyed by column name. Bundler and Node targets; no bundler-less browser build.",
      "error_shape": "A thrown Error whose code property is the code, with the fields (parameter, index, min, max, got, expected, ...) as its other properties."
    },
    {
      "kind": "nuget",
      "name": "UInsight",
      "package_version": "0.36.0",
      "engine_version": "0.36.0",
      "note": "C ABI wrapper over C structs (the cbindgen header), versioned with the crate.",
      "error_shape": "An InsightException whose ErrorCode is the code, Parameter and Index the fields of those names, and Details the rest."
    }
  ],
  "errors": {
    "shape": "A refusal carries a stable snake_case 'code' and the fields listed for that code; how it arrives depends on the surface (error_shape).",
    "source": {
      "catalog": "code_catalog in src/wasm.rs, built from the Code table the refusals are made from; published as codes() in WebAssembly, over the C ABI and as Codes on .NET. What each code means is tabled in README.md, which a test holds equal to the catalog.",
      "test": "src/wasm.rs::code_catalog_tests::the_readme_documents_every_code_and_no_other"
    }
  },
  "operations": [
